# ElForma — server environment template.
# أسماء المتغيرات وقيم وهمية فقط — ممنوع وضع أي سر حقيقي هنا.
# انسخ لـ .env واملأ القيم:  cp .env.example .env
# (موثق في docs/PROJECT_OVERVIEW_FOR_AI.md؛ ملف .env الحقيقي على السيرفر فقط)

# ── أساسيات التشغيل ──
PORT=3000
EF_ENV=production
EF_BASE_URL=https://api.elforma.fit
EF_DATA_DIR=/opt/elforma/data

# ── أسرار (قيم وهمية — املأها في .env فقط) ──
EF_SECRET=change-me-generate-a-long-random-string
EF_ADMIN_SETUP_TOKEN=change-me
EF_METRICS_TOKEN=change-me
EF_PAYMENT_SETTINGS_KEY=change-me

# ── قاعدة البيانات (Turso سحابي؛ بدونه تخزين SQLite محلي) ──
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── البريد (Brevo) ──
EF_MAIL_API_URL=https://api.brevo.com/v3/smtp/email
EF_MAIL_API_KEY=change-me
EF_MAIL_FROM=noreply@elforma.fit
EF_MAIL_ARCHIVE=false
EF_MAIL_OUTBOX_TTL_HOURS=72

# ── الدفع والإشعارات ──
GOOGLE_CLIENT_ID=
EF_FCM_SERVICE_ACCOUNT_FILE=/opt/elforma/secrets/fcm-service-account.json
# أو: EF_FCM_SERVICE_ACCOUNT={"type":"service_account", ...}

# ── النسخ الاحتياطي والإيصالات البعيدة ──
EF_BACKUP_REMOTE_URL=
EF_BACKUP_REMOTE_TOKEN=change-me
EF_BACKUP_KEEP=10
EF_RECEIPTS_REMOTE_URL=
EF_RECEIPTS_REMOTE_TOKEN=change-me
EF_RECEIPTS_TIMEOUT_MS=8000
EF_REQUIRE_DURABLE_RECEIPTS=false

# ── التطبيق (إصدارات/روابط) ──
EF_STORE_URL=https://play.google.com/store/apps/details?id=com.elforma.elforma
EF_RELEASE_MANIFEST_URL=
EF_LATEST_RELEASE=
EF_LATEST_BUILD=
EF_MIN_RELEASE=
EF_MIN_BUILD=
EF_UPDATE_MESSAGE=
EF_ANDROID_CERT_SHA=

# ── ضبط اختياري (القيم الافتراضية شغالة) ──
EF_TRUST_PROXY=false
EF_TRUST_GEO_HEADERS=false
EF_INSECURE_COOKIES=false
EF_LOG_REQUESTS=false
EF_LOG_IP=false
EF_PERF_HEADERS=false
EF_KEEPALIVE_MS=65000
EF_REQUEST_TIMEOUT_MS=30000
EF_SHUTDOWN_GRACE_MS=10000
EF_RUN_JOBS=true
EF_DISTRIBUTED_RATE_LIMIT=false
EF_REQUEST_READ_CACHE=true
EF_CONFIG_CACHE_MS=60000
EF_NUTRITION_CACHE_TTL_MS=300000
EF_NUTRITION_CACHE_MAX=200
REDIS_URL=
# [ITEM-32] عمال حساب الخطط (لكل عملية): سيبها فاضية عشان المعادلة الافتراضية
# المدروسة في lib/engine-pool.js تشتغل: الأنوية − 1 بسقف ذاكرة آمن (ربع ذاكرة
# الجهاز ÷ 128MB للعامل، بحد أقصى 16). مع cluster.js بتتقسم الميزانية على نسخ
# الويب تلقائيًا. حدّد رقم صريح هنا بس لو عايز تتجاوز المعادلة — وهيُحكم بنفس
# سقف الذاكرة. التطبيق الفعلي على الـVPS بيتم من ملف .env وقت النشر.
#ENGINE_POOL_SIZE=
ENGINE_MAX_QUEUE=32
ENGINE_QUEUE_TIMEOUT_MS=5000
ENGINE_TASK_TIMEOUT_MS=20000
EF_SQLITE_REEXEC=false
